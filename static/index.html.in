<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>APT repository · Luca Padovan</title>
<meta name="description" content="Signed APT repository for Debian and Ubuntu with packages by Luca Padovan.">
<meta name="theme-color" content="#111626">
<link rel="icon" href="logo.svg" type="image/svg+xml">
<style>
  /* Matches the look of lucapadovan.dev. */
  :root {
    color-scheme: dark;
    --bg: #111626;
    --panel: #192133;
    --line: #ffffff16;
    --text: #f5f5fc;
    --muted: #b0b8cf;
    --accent: #c1b3ff;
    --mono: ui-monospace, SFMono-Regular, Consolas, monospace;
    --sans: 'Segoe UI', Inter, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.7 var(--sans); }
  ::selection { background: var(--accent); color: var(--bg); }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  code { font-family: var(--mono); font-size: 0.9em; }

  .page-shell { max-width: 1120px; margin: auto; padding: 0 56px; }

  header { height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: flex; align-items: center; gap: 12px; }
  .wordmark img { width: 44px; height: 44px; display: block; transition: transform .25s; }
  .wordmark:hover img { transform: translateY(-2px); }
  .wordmark span { font-size: 16px; font-weight: 600; letter-spacing: -.3px; }
  .wordmark:hover { color: var(--text); }
  nav { display: flex; gap: 8px; background: #ffffff05; padding: 6px; border: 1px solid var(--line); border-radius: 999px; }
  nav a { font-size: 14px; padding: 7px 18px; border-radius: 999px; transition: background .2s; }
  nav a:hover { background: #ffffff09; color: var(--text); }

  .eyebrow { color: var(--accent); font: 12px var(--mono); letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 16px; }
  .hero { padding: 56px 0 60px; }
  h1 { font-size: clamp(38px, 5vw, 60px); line-height: 1.12; letter-spacing: -2px; font-weight: 650; margin: 0 0 24px; overflow-wrap: anywhere; }
  h1 span { color: var(--accent); }
  .intro { font-size: 18px; color: var(--muted); max-width: 680px; line-height: 1.8; margin: 0; }

  .section { padding: 56px 0; border-top: 1px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; margin-bottom: 32px; }
  .section-heading > p { margin: 0; color: var(--muted); max-width: 300px; }
  h2 { font-size: clamp(30px, 3vw, 40px); line-height: 1.16; letter-spacing: -1px; margin: 0; font-weight: 600; }

  .code { position: relative; }
  pre {
    margin: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px 96px 24px 26px;
    overflow-x: auto;
    font: 14px/1.8 var(--mono);
    color: #e3e6f1;
  }
  .copy {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 1px solid #ffffff24;
    border-radius: 12px;
    background: #ffffff05;
    color: var(--text);
    font: 600 13px var(--sans);
    padding: 7px 14px;
    cursor: pointer;
    transition: background .2s;
  }
  .copy:hover { background: #ffffff0d; }

  .packages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .packages li { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-top: 2px solid var(--accent); border-radius: 18px; padding: 26px 28px; transition: border-color .3s; }
  .packages li:hover { border-color: #c1b3ff55; border-top-color: var(--accent); }
  .pkg-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .badge { font: 11px var(--mono); letter-spacing: .3px; color: #d0d5e8; background: #ffffff09; border-radius: 999px; padding: 6px 10px; }
  .version { font: 13px var(--mono); color: #e2d9ff; }
  .badge, .version, .eyebrow { cursor: default; -webkit-user-select: none; user-select: none; }
  .packages h3 { font-size: 32px; line-height: 1.2; letter-spacing: -1px; margin: 0 0 10px; font-weight: 650; }
  .packages p { color: var(--muted); margin: 0 0 22px; }
  .install { margin-top: auto; align-self: flex-start; border: 1px solid #c1b3ff35; border-radius: 10px; color: var(--accent); background: #c1b3ff08; padding: 8px 14px; font-size: 14px; }

  dl { display: grid; grid-template-columns: 200px 1fr; margin: 0; border: 1px solid var(--line); border-radius: 18px; background: #ffffff03; overflow: hidden; }
  dt, dd { margin: 0; padding: 16px 24px; border-top: 1px solid var(--line); }
  dt:first-of-type, dd:first-of-type { border-top: 0; }
  dt { font: 12px/2 var(--mono); letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }
  dd { color: #e3e6f1; overflow-wrap: anywhere; }
  dd a { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }

  footer { display: flex; justify-content: space-between; gap: 20px; padding: 32px 0 34px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  footer a { color: var(--text); }

  @media (max-width: 760px) {
    .page-shell { padding: 0 20px; }
    header { height: 85px; }
    .hero { padding: 32px 0 42px; }
    h1 { letter-spacing: -1.3px; }
    .intro { font-size: 17px; }
    .section { padding: 42px 0; }
    .section-heading { display: block; }
    .section-heading > p { margin-top: 12px; max-width: none; }
    pre { padding: 60px 20px 20px; font-size: 13px; }
    .packages { grid-template-columns: minmax(0, 1fr); }
    dl { grid-template-columns: 1fr; }
    dd { border-top: 0; padding-top: 0; }
    footer { flex-wrap: wrap; }
  }
  @media (max-width: 420px) {
    .wordmark span { display: none; }
    .packages li { padding: 22px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; }
  }
</style>
</head>
<body>
<div class="page-shell">
  <header>
    <a class="wordmark" href="https://lucapadovan.dev"><img src="logo.svg" alt="" width="44" height="44"><span>Luca Padovan</span></a>
    <nav aria-label="Sections">
      <a href="#setup">Setup</a>
      <a href="#packages">Packages</a>
      <a href="#details">Details</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">APT repository · Debian &amp; Ubuntu</p>
      <h1>apt.<span>lucapadovan</span>.dev</h1>
      <p class="intro">A signed APT repository for Debian, Ubuntu and their derivatives. Packages are rebuilt from each project's GitHub releases, so updates arrive with <code>apt upgrade</code>.</p>
    </section>

    <section class="section" id="setup">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Setup</p><h2>Add the repository</h2></div>
        <p>Run once. It installs the signing key and a source that trusts only that key.</p>
      </div>
      <div class="code">
        <pre id="setup-commands">sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://apt.lucapadovan.dev/lucapadovan.gpg | sudo tee /etc/apt/keyrings/lucapadovan.gpg &gt;/dev/null
echo "deb [signed-by=/etc/apt/keyrings/lucapadovan.gpg] https://apt.lucapadovan.dev stable main" \
  | sudo tee /etc/apt/sources.list.d/lucapadovan.list
sudo apt update</pre>
        <button class="copy" type="button" data-copy="setup-commands" hidden>Copy</button>
      </div>
    </section>

    <section class="section" id="packages">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Packages</p><h2>Available packages</h2></div>
        <p>Install any of them with <code>apt</code> once the repository is added.</p>
      </div>
      <ul class="packages">
$packages
      </ul>
    </section>

    <section class="section" id="details">
      <div class="section-heading">
        <div><p class="eyebrow">03 / Details</p><h2>Repository details</h2></div>
      </div>
      <dl>
        <dt>Suite</dt><dd><code>stable</code>, component <code>main</code></dd>
        <dt>Signing key</dt><dd><code>$fingerprint</code> · <a href="lucapadovan.asc">ASCII</a> · <a href="lucapadovan.gpg">binary</a></dd>
        <dt>Source</dt><dd><a href="https://github.com/padovanl/packages">github.com/padovanl/packages</a></dd>
        <dt>Removal</dt><dd><code>sudo rm /etc/apt/sources.list.d/lucapadovan.list /etc/apt/keyrings/lucapadovan.gpg</code></dd>
      </dl>
    </section>
  </main>

  <footer>
    <span>© Luca Padovan</span>
    <a href="https://lucapadovan.dev">lucapadovan.dev</a>
  </footer>
</div>
<script>
  if (navigator.clipboard) {
    document.querySelectorAll('.copy').forEach(function (button) {
      button.hidden = false;
      button.addEventListener('click', function () {
        navigator.clipboard.writeText(document.getElementById(button.dataset.copy).textContent).then(function () {
          button.textContent = 'Copied';
          setTimeout(function () { button.textContent = 'Copy'; }, 1500);
        });
      });
    });
  }
</script>
</body>
</html>
